a.post-card(href="{{ include.post.url }}")
  | {% if include.post.og_image %}
  img(src="{{ include.post.og_image }}" alt="" width="1200" height="630" loading="lazy")
  | {% else %}
  img(src="/assets/images/og/{{ include.post.slug }}.png" alt="" width="1200" height="630" loading="lazy")
  | {% endif %}
  .post-copy
    time(datetime="{{ include.post.date | date_to_xmlschema }}") {{ include.post.date | date: '%b %d, %Y' }}
    h4 {{ include.post.title }}
    p {{ include.post.excerpt | strip_html | truncatewords: 22 }}
